# --- API (apps/api) ---
PORT=4000
DATABASE_PATH=./data/events.db
# Scraper (enabled by default, see README "Data sources & legal notice")
SCRAPER_ENABLED=true
SCRAPE_INTERVAL_HOURS=12
# Identify your bot with a real contact so site owners can reach you
SCRAPER_USER_AGENT="BeatMapBot/0.1 (+https://github.com/YOUR_USER/beatmap; contact: you@example.com)"
NOMINATIM_EMAIL=you@example.com

# --- Web (apps/web) ---
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=BeatMap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any MapLibre-compatible style URL (MapTiler, Stadia, OpenFreeMap...)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
